<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AgenticAI.Client</RootNamespace>
    <AssemblyName>AgenticAI.Client</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>AgenticAI Contributors</Authors>
    <Description>
      .NET 8 client SDK for the Agentic AI REST + SSE server.
      Supports chat streaming, RAG sessions, document ingestion, and feedback.
    </Description>
    <PackageTags>agenticai;sse;streaming;llm;rag;ai</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

</Project>
